# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repositorio.
# (En Codespaces se copia solo al crear el entorno.)

# ---------- MySQL (docker compose) ----------
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_PASSWORD=boleteria_pass

# Clave compartida entre microservicios para las rutas /internal.
# Genera una:  python -c "import secrets;print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=cambia-esta-clave-interna-en-el-env

# ---------- Reglas de negocio ----------
RESERVA_MINUTOS=10          # RN16: minutos que dura una reserva antes de expirar
SESSION_MINUTES=120         # duración de la sesión

# ---------- Datos de demostración ----------
SEED_AL_INICIAR=true        # el gateway crea admin, usuario demo, escenarios, eventos y ventas de ejemplo
ADMIN_CORREO=admin@boleteria.com
ADMIN_CONTRASENA=Admin12345

# ---------- Solo para correr SIN Docker (python -m scripts.run_dev) ----------
# Base de datos local:
# DATABASE_URL_TEMPLATE=mysql+pymysql://boleteria:boleteria_pass@localhost:3306/{schema}?charset=utf8mb4
# O una base PostgreSQL en la nube (Neon), un schema por microservicio, sin {schema}:
# DATABASE_URL_TEMPLATE=postgresql://USUARIO:CLAVE@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
